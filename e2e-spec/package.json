{
  "name": "naw-e2e-spec",
  "private": true,
  "version": "0.1.0",
  "description": "移植元の結合テスト項目書（627 項目）に沿って、React + backend が移植元と同じに動くかを確かめる E2E テスト",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "spec:all": "node src/cli.ts run",
    "env:up": "node src/cli.ts env:up",
    "env:down": "node src/cli.ts env:down",
    "test": "playwright test",
    "report": "node src/cli.ts report",
    "merge": "node src/cli.ts merge",
    "install:browsers": "playwright install chromium",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
