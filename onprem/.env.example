# 既定値を変えるときだけ .env にコピーして書き換える（.env がなくても起動できる）

# server-local の認証キー。クラウド側の LOCAL_SERVER エンドポイントの API キーと同じ値にする
# SERVER_LOCAL_AUTH_KEY=onprem-local-key

# server-local と Waha! エミュレーターが共有する認証キー
# WAHA_AUTHKEY=onprem-waha-key

# クラウド側 backend の origin（ライブラリのスタブ作成で呼ぶ）。既定はルートの compose の backend
# NAW_BASE_URL=http://host.docker.internal:8001

# LLM の接続先。echo（キー不要。質問をそのまま返す）または azure_openai
# LLM_PROVIDER=echo
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# LOG_LEVEL=INFO
