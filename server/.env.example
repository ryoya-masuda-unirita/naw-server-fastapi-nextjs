DATABASE_URL=postgresql+asyncpg://root:root@localhost:5433/postgres
# JWT の署名鍵。必須。本番では、推測されない長い値にする（変えると、発行済みのトークンは無効になる）
SECRET_KEY=changeme
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_REGEX=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REDIS_URL=redis://localhost:6380/0
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_RESPONSES_API_VERSION=2025-04-01-preview
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET_NAME=secuaigent-user-import-jobs-dev-local
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/secuaigent-user-import-jobs-queue-dev-local
AWS_SQS_LISTENER_ENABLED=true

# --- 以降は任意（書かなければ、既定値で動く）。必要なものだけ、コメントを外す ---
# アップロードされたファイルの保存先
# FILE_STORAGE_ROOT=./data/files
# クレジットの計算（1 クレジット当たりのトークン数、入力トークンの重み）
# TOKENS_PER_CREDIT=1000
# INPUT_CREDIT_WEIGHT=0.3333333333333333
# パスワード再設定の失敗の上限と、ロックの時間（分）
# PASSWORD_RESET_MAX_FAILURE_ATTEMPTS=5
# PASSWORD_RESET_LOCKOUT_MINUTES=15
# ファイルのテキストの取り出し（Apache Tika）。未設定なら、テキスト系の形式だけを自前で読む
# TIKA_SERVER_JAR=
# TIKA_URL=
# TIKA_JAVA_COMMAND=java
# TIKA_PORT=9998
# TIKA_HEAP=256m
# TIKA_START_TIMEOUT_SECONDS=60
# TIKA_REQUEST_TIMEOUT_SECONDS=120
# Azure の利用料金の取得 API を使うときだけ必要（5 つとも必須。使わなければ不要）
# AZURE_APP_SUBSCRIPTION_ID=
# AZURE_APP_RESOURCE_GROUP_NAME=
# AZURE_APP_TENANT_ID=
# AZURE_APP_CLIENT_ID=
# AZURE_APP_CLIENT_SECRET_VALUE=
