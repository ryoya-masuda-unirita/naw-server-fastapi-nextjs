# ホストで動かすとき（uv run）用。このファイルを .env にコピーして値を設定する（.env は git 管理外）
# Docker で動かすときは、このファイルではなく onprem/.env（onprem/.env.example）を使う

# 必須。server-local の WAHA_AUTHKEY と同じ値にする
WAHA_AUTHKEY=ここに認証キーを入力してください

# LLM の接続先。echo（キー不要。質問をそのまま返す）または azure_openai
LLM_PROVIDER=echo

# LLM_PROVIDER=azure_openai のときに設定する
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# サービス ID ごとにアダプタの設定を変えるときの JSON（README の「ワークフローの設定」）。
# ホストで動かすときのパス。Docker（onprem/）では /app/config/workflows.example.json を指定する
# WAHA_WORKFLOWS_FILE=./config/workflows.example.json

# ノードと線で組んだワークフローの保存先。設定すると管理用 API（/admin/workflows）が有効になる
# WAHA_STUDIO_DIR=./data/workflows

# 以下は既定値のままでよい
# 埋め込みの学習で、execute の filepath に渡されたパスを読んでよいディレクトリ（コンテナから見たパス）
# SOURCE_ALLOWED_DIR=
# true: execute はジョブの完了まで応答しない / false: 受け付けたらすぐ応答する
# EXECUTE_WAIT_FOR_COMPLETION=true
# ホストで動かすときに streamfilepath を制限するディレクトリ（Docker では設定済み）
# STREAM_ALLOWED_DIR=../secuaigent-server-local/data/stream-output
# 使われていないセッションを破棄するまでの秒数
# SESSION_IDLE_TIMEOUT_SECONDS=3600
# LOG_LEVEL=INFO
