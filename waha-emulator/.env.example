# このファイルを .env にコピーして値を設定する（.env は git 管理外）

# 必須。server-local の WAHA_AUTHKEY と同じ値にする
WAHA_AUTHKEY=ここに認証キーを入力してください

# LLM の接続先。echo（キー不要。質問をそのまま返す）または azure_openai
LLM_PROVIDER=echo

# LLM_PROVIDER=azure_openai のときに設定する
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Docker で動かすときの公開ポート・ストリームファイルのディレクトリ・実行ユーザー
# （ストリームファイルのディレクトリは server-local の data/stream-output を指す）
WAHA_EMULATOR_PORT=8091
WAHA_EMULATOR_STREAM_DIR=../server-local/data/stream-output
WAHA_EMULATOR_UID=1000
WAHA_EMULATOR_GID=1000

# 以下は既定値のままでよい
# true: execute はジョブの完了まで応答しない / false: 受け付けたらすぐ応答する
# EXECUTE_WAIT_FOR_COMPLETION=true
# ホストで動かすときに streamfilepath を制限するディレクトリ（Docker では設定済み）
# STREAM_ALLOWED_DIR=
# LOG_LEVEL=INFO
