# このファイルを .env にコピーして値を設定する（.env は git 管理外）

# 必須。ブラウザ（NAW）からのリクエストの X-SERVER-AUTH-KEY と一致させる
SECURITY_SERVER_AUTH_KEY=ここに認証キーを入力してください

# Waha! の URL（末尾の / を付ける）と、REST 管理コンソールで取得した認証キー
WAHA_URL=http://host.docker.internal/
WAHA_AUTHKEY=

# NAW 本体（クラウド API）の origin。ライブラリのスタブ作成・タイトル更新で呼ぶ
NAW_BASE_URL=

# Tomcat の war 配置と同じパス（例: /secuaigent）で公開する場合に指定する
CONTEXT_PATH=

# Waha! から見たストリームファイルの出力先（コンテナ内の /app/data/stream-output と
# 同じディレクトリを Waha! が別のパスで参照する場合に指定する）
STREAM_WAHA_OUTPUT_DIR=

# ホスト側の公開ポート・データの置き場所・実行ユーザー
SERVER_LOCAL_PORT=8090
SERVER_LOCAL_DATA_DIR=./data
SERVER_LOCAL_UID=1000
SERVER_LOCAL_GID=1000

# 以下は既定値のままでよい（移植元 application.yml の stream.* と同じ既定値）
# STREAM_TAIL_POLL_INTERVAL_MS=200
# STREAM_RESULT_POLL_INTERVAL_MS=2000
# STREAM_EMITTER_TIMEOUT_MS=600000
# STREAM_ORPHAN_CLEANUP_MAX_AGE_HOURS=24
# LOG_LEVEL=INFO
# TZ=Asia/Tokyo
