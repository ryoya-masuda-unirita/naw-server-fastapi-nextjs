# vite build（mode=production）で .env の VITE_API_URL（ローカル開発用の絶対URL）を上書きする。
# dev環境はCloudFrontが /api/*・/backend/auth/* をbackend（ALB）へ転送するため、
# APIは配信元と同じオリジンの相対パスで呼ぶ（ローカルURLや本家のドメインをビルドに含めない）。
VITE_API_URL=
# 認証API（/auth/...）はReactの画面（/auth/login 等）と同じパスのため、/backend を付けて /backend/auth/... で呼ぶ。
# CloudFront（infra/cloudfront.tf）が /backend/auth/* をbackendへ転送し、/backend を外して渡す（#240）。
VITE_AUTH_API_URL=/backend
