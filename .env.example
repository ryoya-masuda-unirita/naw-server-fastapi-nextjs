# ルートの docker-compose.yml が読む設定。.env にコピーして、変えたい値だけ書く（.env がなくても、既定値で動く）。
#   cp .env.example .env

# ホストに公開するポート（画面は 127.0.0.1 だけに公開する）
FRONTEND_PORT=5173
BACKEND_PORT=8001
# backend を公開するアドレス。ログイン用のデータ（admin / admin@1234）が入るため、既定は手元だけ（127.0.0.1）。
# Linux の Docker で、onprem の server-local など別のコンテナから host.docker.internal 経由で届かないときだけ、0.0.0.0 にする
BACKEND_HOST=127.0.0.1

# backend の署名鍵（JWT など）。ローカル用の値。本番の値は入れない
SECRET_KEY=dev-secret-not-for-production

# ローカルは HTTP のため、Cookie に Secure を付けない
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- backend の接続先（コンテナ間の名前。ふつうは変えない） ---
DATABASE_URL=postgresql+asyncpg://root:root@postgres:5432/postgres
REDIS_URL=redis://redis:6379/0
# localstack（AWS の偽物）
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET_NAME=secuaigent-user-import-jobs-dev-local
AWS_SQS_QUEUE_URL=http://localstack:4566/000000000000/secuaigent-user-import-jobs-queue-dev-local
# 画面から backend を呼べるようにする。FRONTEND_PORT を変えたら、ここも合わせる
CORS_ALLOWED_ORIGINS=http://localhost:5173
